{
  "name": "@janhq/core",
  "version": "0.1.10",
  "description": "Core library for the Jan AI application framework",
  "keywords": [
    "jan",
    "core"
  ],
  "homepage": "https://jan.ai",
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "typings": "dist/types/index.d.ts",
  "files": [
    "dist",
    "types"
  ],
  "author": "Jan <service@jan.ai>",
  "scripts": {
    "lint": "tslint --project tsconfig.json -t codeFrame 'src/**/*.ts' 'test/**/*.ts'",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "prebuild": "rimraf dist",
    "build": "tsc -p . && rolldown -c rolldown.config.mjs"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "@vitest/ui": "5.1.0",
    "eslint": "10.14.0",
    "react": "19.3.1",
    "rimraf": "6.1.4",
    "rolldown": "1.3.0",
    "tslib": "2.9.1",
    "typescript": "6.0.3",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "rxjs": "7.8.2",
    "ulidx": "2.4.1"
  },
  "peerDependencies": {
    "react": "19.3.1"
  },
  "packageManager": "yarn@4.18.1"
}
