{
  "identifier": "io.github.tronabs.novera.ios",
  "version": "1.0.4",
  "build": {
    "devUrl": null,
    "frontendDist": "../web-app/dist",
    "beforeDevCommand": "cross-env IS_DEV=true IS_IOS=true yarn build:web",
    "beforeBuildCommand": "cross-env IS_IOS=true yarn build:web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Novera",
        "url": "index.html",
        "create": true,
        "visible": true
      }
    ],
    "security": {
      "capabilities": ["mobile"]
    }
  },
  "plugins": {},
  "bundle": {
    "active": true,
    "iOS": {
      "developmentTeam": "<DEVELOPMENT_TEAM_ID>"
    },
    "resources": [
      "resources/LICENSE"
    ],
    "externalBin": []
  }
}
