{
  "identifier": "io.github.tronabs.novera",
  "version": "1.0.3",
  "build": {
    "devUrl": null,
    "frontendDist": "../web-app/dist",
    "beforeDevCommand": "cross-env IS_DEV=true IS_ANDROID=true yarn build:web",
    "beforeBuildCommand": "cross-env IS_ANDROID=true yarn build:web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Novera",
        "url": "index.html",
        "create": true,
        "visible": true,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "capabilities": ["mobile"]
    }
  },
  "plugins": {},
  "bundle": {
    "active": true,
    "resources": [
      "resources/LICENSE"
    ],
    "externalBin": [],
    "android": {
      "minSdkVersion": 24,
      "versionCode": 1000026,
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
