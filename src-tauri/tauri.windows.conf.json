{
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Novera",
        "width": 1200,
        "minWidth": 640,
        "height": 800,
        "minHeight": 480,
        "resizable": true,
        "maximized": true,
        "fullscreen": false,
        "zoomHotkeysEnabled": false,
        "center": true,
        "hiddenTitle": true,
        "transparent": true,
        "trafficLightPosition": {
          "x": 20,
          "y": 32
        },
        "decorations": false,
        "titleBarStyle": "Overlay",
        "windowEffects": {
          "effects": [
            "fullScreenUI",
            "mica",
            "tabbed",
            "blur",
            "acrylic"
          ],
          "state": "active"
        },
        "dragDropEnabled": false
      }
    ]
  },
  "bundle": {
    "targets": [
      "nsis",
      "msi"
    ],
    "resources": [
      "resources/LICENSE",
      "resources/bin/novera-llama-worker.exe",
      "resources/bin/*.dll",
      "resources/image-engine/*.*",
      "resources/image-engine/cuda/*.*",
      "resources/image-engine/vulkan/*.*",
      "resources/image-engine/cpu/*.*",
      "resources/image-engine/licenses/*"
    ],
    "externalBin": [
      "resources/bin/bun",
      "resources/bin/uv"
    ],
    "windows": {
      "webviewInstallMode": {
        "silent": true,
        "type": "downloadBootstrapper"
      }
    }
  }
}
