{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "mobile",
  "description": "enables the default permissions for mobile platforms",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-theme",
    "core:app:allow-set-app-theme",
    "os:default",
    "log:default",
    "store:default",
    "hardware:default",
    "llamacpp:default",
    "vector-db:default",
    "rag:default",
    "websearch:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://*"
        },
        {
          "url": "http://127.0.0.1:*"
        }
      ]
    },
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://*:*"
        },
        {
          "url": "http://127.0.0.1:*"
        },
        {
          "url": "http://localhost:*"
        }
      ],
      "deny": []
    }
  ],
  "platforms": [
    "android",
    "iOS"
  ]
}
