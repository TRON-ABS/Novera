 // Returns the encoded command, or std::nullopt if the operation is a no-op
+// F32 gather matching the CPU COL2IM_1D summation order. Each invocation owns
+// one output sample; no atomics, clamping, or CPU/GPU activation round trips.
+static webgpu_encoded_op novera_webgpu_col2im(webgpu_context & ctx, ggml_tensor * src, ggml_tensor * dst) {
+    auto & pipeline = ctx->global_ctx->novera_col2im_pipeline;
+    if (!pipeline.pipeline) {
+        pipeline = ggml_webgpu_create_pipeline(ctx->global_ctx->device, R"WGSL(
+@group(0) @binding(0) var<storage, read_write> input: array<f32>;
+@group(0) @binding(1) var<storage, read_write> output: array<f32>;
+struct Params { offset_i:u32, offset_o:u32, k_oc:u32, t_in:u32, t_out:u32, oc:u32, stride:u32, padding:u32 }
+@group(0) @binding(2) var<uniform> p: Params;
+@compute @workgroup_size(64)
+fn main(@builtin(global_invocation_id) gid:vec3<u32>, @builtin(num_workgroups) groups:vec3<u32>) {
+    let index = gid.x + groups.x * 64u * gid.y;
+    if (index >= p.t_out * p.oc) { return; }
+    let channel = index / p.t_out;
+    let absolute_t = i32(index % p.t_out + p.padding);
+    let kernel = i32(p.k_oc / p.oc);
+    let low = max(0, (absolute_t - kernel + i32(p.stride)) / i32(p.stride));
+    let high = min(i32(p.t_in)-1, absolute_t / i32(p.stride));
+    var sum = 0.0f;
+    for (var t = low; t <= high; t++) {
+        let k = absolute_t - t * i32(p.stride);
+        if (k >= 0 && k < kernel) {
+            sum += input[p.offset_i + channel * u32(kernel) + u32(k) + u32(t) * p.k_oc];
+        }
+    }
+    output[p.offset_o + index] = sum;
+}
+)WGSL", "novera_col2im_1d_f32");
