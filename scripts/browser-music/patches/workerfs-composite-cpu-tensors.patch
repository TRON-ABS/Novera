+static bool store_read_silence(const GGUFModel & gf, std::vector<float> & target) {
+    const int64_t index = gguf_find_tensor(gf.gguf, "silence_latent");
+    const auto * tensor = ggml_get_tensor(gf.meta, "silence_latent");
+    if (!tensor || tensor->type != GGML_TYPE_F32 || ggml_nelements(tensor) != 15000 * 64) return false;
+    target.resize(15000 * 64);
+    return gf_copy_tensor(gf, index, tensor, target.data(), target.size() * sizeof(float));
+}
