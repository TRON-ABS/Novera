+#ifdef __EMSCRIPTEN__
+struct WctxRange {
+    size_t start;
+    size_t end;
+};
+
+static WctxRange wctx_window_for_copy(const WeightCtx & wctx, size_t index, size_t offset, size_t count) {
+    const auto & copy = wctx.pending[index];
+    WctxRange window{copy.file_offset + offset, copy.file_offset + offset + count};
+    if (wctx.group_ranges && offset + count == copy.nbytes) {
+        // Keep the upload order and the original grouping policy.
+        for (size_t next = index + 1; next < wctx.pending.size(); ++next) {
+            const auto & following = wctx.pending[next];
+            if (following.fd != copy.fd) break;
+            const size_t first = std::min(window.start, following.file_offset);
+            const size_t last = std::max(window.end, following.file_offset + following.nbytes);
+            if (last - first > WCTX_RANGE_BUFFER_BYTES) break;
+            window = {first, last};
+        }
+    }
+    return window;
+}
+
+static bool wctx_prefetch_next(WeightCtx & wctx, size_t index, size_t offset, int fd, WctxRange current) {
+    for (; index < wctx.pending.size(); ++index, offset = 0) {
+        const auto & copy = wctx.pending[index];
+        if (copy.fd < 0) continue;
+        for (; offset < copy.nbytes; ) {
+            const size_t count = std::min(WCTX_RANGE_BUFFER_BYTES, copy.nbytes - offset);
+            const size_t start = copy.file_offset + offset;
+            if (copy.fd != fd || start < current.start || start + count > current.end) {
+                const WctxRange next = wctx_window_for_copy(wctx, index, offset, count);
+                const double started = emscripten_get_now();
+                const bool ready = wctx_begin_read_ahead(copy.fd, next.start, next.end - next.start);
+                wctx.range_stats.ms += emscripten_get_now() - started;
+                return ready;
+            }
+            offset += count;
+        }
+    }
+    return false;
+}
+#endif
