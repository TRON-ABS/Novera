+#ifdef __EMSCRIPTEN__
+static constexpr size_t WCTX_RANGE_BUFFER_BYTES = 64 * 1024 * 1024;
+
+static bool wctx_read_range(WeightCtx * wctx, int fd, size_t offset, void * data, size_t size) {
+    const double started = emscripten_get_now();
+    if (lseek(fd, static_cast<off_t>(offset), SEEK_SET) != static_cast<off_t>(offset)) {
+        wctx->range_stats.failed = true;
+        return false;
+    }
+    auto * bytes = static_cast<uint8_t *>(data);
+    size_t done = 0;
+    while (done < size) {
+        const auto count = read(fd, bytes + done, size - done);
+        ++wctx->range_stats.calls;
+        if (count <= 0) {
+            wctx->range_stats.failed = true;
+            return false;
+        }
+        done += static_cast<size_t>(count);
+    }
+    wctx->range_stats.bytes += done;
+    wctx->range_stats.ms += emscripten_get_now() - started;
+    return true;
+}
+#endif
