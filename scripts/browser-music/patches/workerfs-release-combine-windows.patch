+static void wctx_order_file_uploads(WeightCtx * wctx) {
+    // A view can alias another tensor. Fused tensors can have several writes
+    // but these must cover disjoint destination ranges to change their order.
+    std::unordered_map<const ggml_tensor *, size_t> destination_ends;
+    for (const auto & copy : wctx->pending) {
+        if (copy.tensor->view_src) return;
+        auto & end = destination_ends[copy.tensor];
+        const size_t bytes = copy.convert_from == GGML_TYPE_COUNT ? copy.nbytes : 2 * copy.nbytes;
+        const size_t capacity = ggml_nbytes(copy.tensor);
+        if (copy.offset < end || copy.offset > capacity || bytes > capacity - copy.offset) return;
+        end = copy.offset + bytes;
+    }
+    std::stable_sort(wctx->pending.begin(), wctx->pending.end(), [](const auto & a, const auto & b) {
+        if (a.fd != b.fd) return a.fd < b.fd;
+        return a.file_offset < b.file_offset;
+    });
+    wctx->range_stats.file_order = true;
+}
