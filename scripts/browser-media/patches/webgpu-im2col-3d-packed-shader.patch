+@compute @workgroup_size(WG_SIZE)
+fn main(@builtin(global_invocation_id) gid: vec3<u32>, @builtin(num_workgroups) groups: vec3<u32>) {
+    let thread = gid.x + groups.x * u32(WG_SIZE) * gid.y;
+    let k_size = params.KW * params.KH * params.KD * params.IC;
+    let columns = params.OW * params.OH * params.OD * params.N;
+#ifdef PACKED_IM2COL_3D
+    let packed_k = k_size / 4u;
+    if (thread >= packed_k * columns) { return; }
+    let k = (thread % packed_k) * 4u;
+    var m = thread / packed_k;
+#else
