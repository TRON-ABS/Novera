+#ifdef NOVERA_CONV_SPATIAL64
+#include "common_decls.tmpl"
+enable f16;
+
+@group(0) @binding(0)
+var<storage, read_write> weights: array<WEIGHT_TYPE>;
+@group(0) @binding(1)
+var<storage, read_write> input: array<INPUT_TYPE>;
+@group(0) @binding(2)
+var<storage, read_write> output: array<OUTPUT_TYPE>;
+
+struct Params {
+    offset_w: u32,
+    offset_i: u32,
+    offset_o: u32,
+
+    // element strides
+    sw0: u32, sw1: u32, sw2: u32, sw3: u32,
+    si0: u32, si1: u32, si2: u32, si3: u32,
+    so0: u32, so1: u32, so2: u32, so3: u32,
+
+    // kernel dimensions
+    KW: u32, KH: u32, IC: u32,
+    // input dimensions
+    IW: u32, IH: u32,
+    // output dimensions
+    OW: u32, OH: u32, OC_out: u32, N_out: u32,
+
+    // stride
+    s0: u32, s1: u32,
+    // padding
+    p0: u32, p1: u32,
+    // dilation
+    d0: u32, d1: u32,
+};
+
+@group(0) @binding(3)
+var<uniform> params: Params;
+
+#define CONV_K WG_SIZE
+#define CONV_M WG_SIZE
+
+// Register-tiled implicit convolution. Each of 64 threads computes a 4x4
+// output block; F32 shared rows have one pad to avoid bank conflicts.
+var<workgroup> input_tile: array<f32, CONV_K * (CONV_M + 1u)>;
+var<workgroup> weight_tile: array<f32, WG_SIZE * (CONV_K + 1u)>;
+@compute @workgroup_size(CONV_M / 4u, 8)
+fn main(@builtin(workgroup_id) wid: vec3<u32>,
+        @builtin(num_workgroups) num_wg: vec3<u32>,
+        @builtin(local_invocation_id) lid: vec3<u32>) {
+    let positions = params.OW * params.OH;
+    let tiles_m = (positions + CONV_M - 1u) / CONV_M;
+    let tiles_n = (params.OC_out + WG_SIZE - 1u) / WG_SIZE;
+    let tile = wid.x + wid.y * num_wg.x;
+    if (tile >= tiles_m * tiles_n * params.N_out) { return; }
+    let batch = tile / (tiles_m * tiles_n);
+    let tile_n = (tile / tiles_m) % tiles_n;
+    let tile_m = tile % tiles_m;
+    let position_base = tile_m * CONV_M + lid.x * 4u;
+    let oc_base = tile_n * WG_SIZE + lid.y * 4u;
+    let reduction = params.KW * params.KH * params.IC;
+    let tid = lid.y * (CONV_M / 4u) + lid.x;
+    var a0 = vec4<f32>(0.0); var a1 = vec4<f32>(0.0);
+    var a2 = vec4<f32>(0.0); var a3 = vec4<f32>(0.0);
+    for (var base = 0u; base < reduction; base += CONV_K) {
+        for (var elem = tid; elem < CONV_M * CONV_K; elem += CONV_M * 2u) {
+            let pos_local = elem % CONV_M;
+            let k_local = elem / CONV_M;
+            let position = tile_m * CONV_M + pos_local;
+            let ka = base + k_local;
+            let kw = ka % params.KW;
+            let kh = (ka / params.KW) % params.KH;
+            let ic = ka / (params.KW * params.KH);
+            let iw = i32((position % params.OW) * params.s0 + kw * params.d0) - i32(params.p0);
+            let ih = i32((position / params.OW) * params.s1 + kh * params.d1) - i32(params.p1);
+            var value = 0.0f;
+            if (position < positions && ka < reduction && iw >= 0 && ih >= 0 && iw < i32(params.IW) && ih < i32(params.IH)) {
+                value = f32(input[params.offset_i + u32(iw) * params.si0 + u32(ih) * params.si1 + ic * params.si2 + batch * params.si3]);
+            }
+            input_tile[k_local * (CONV_M + 1u) + pos_local] = value;
+        }
+        for (var elem = tid; elem < WG_SIZE * CONV_K; elem += CONV_M * 2u) {
+            let n_local = elem / CONV_K;
+            let wk_local = elem % CONV_K;
+            let kb = base + wk_local;
+            let oc = tile_n * WG_SIZE + n_local;
+            var weight = 0.0f;
+            if (oc < params.OC_out && kb < reduction) {
+                let wk = kb % params.KW;
+                let hk = (kb / params.KW) % params.KH;
+                let ck = kb / (params.KW * params.KH);
+                weight = f32(weights[params.offset_w + wk * params.sw0 + hk * params.sw1 + ck * params.sw2 + oc * params.sw3]);
+            }
+            weight_tile[n_local * (CONV_K + 1u) + wk_local] = weight;
+        }
+        workgroupBarrier();
+        for (var k = 0u; k < CONV_K; k++) {
+            let i = k * (CONV_M + 1u) + lid.x * 4u;
+            let x = vec4<f32>(input_tile[i], input_tile[i+1u], input_tile[i+2u], input_tile[i+3u]);
+            let w = vec4<f32>(weight_tile[(lid.y*4u)*(CONV_K+1u)+k],weight_tile[(lid.y*4u+1u)*(CONV_K+1u)+k],weight_tile[(lid.y*4u+2u)*(CONV_K+1u)+k],weight_tile[(lid.y*4u+3u)*(CONV_K+1u)+k]);
+            a0 += x.x * w; a1 += x.y * w; a2 += x.z * w; a3 += x.w * w;
+        }
+        workgroupBarrier();
+    }
+    let accum = array<vec4<f32>,4>(a0,a1,a2,a3);
+    for (var m = 0u; m < 4u; m++) {
+        let position = position_base + m;
+        if (position >= positions) { continue; }
+        for (var n = 0u; n < 4u; n++) {
+            let oc = oc_base + n;
+            if (oc < params.OC_out) {
+                output[params.offset_o + (position%params.OW)*params.so0 + (position/params.OW)*params.so1 + oc*params.so2 + batch*params.so3] = OUTPUT_TYPE(accum[m][n]);
+            }
+        }
+    }
+}
+
+#else
 #include "common_decls.tmpl"
 enable f16;
 
