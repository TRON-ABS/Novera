 fn padded_matmul_shmem_index(index: u32) -> u32 {
+#ifdef NOVERA_MATMUL_TRANSPOSED_SHARED
+    if (index < TILE_SRC0_SHMEM) { return novera_src0_index(index); }
+    return novera_src1_index(index);
+#else
     return (index / TILE_K) * (TILE_K + 2u) + index % TILE_K;
+#endif
+}
+fn novera_src0_index(index: u32) -> u32 {
+#ifdef NOVERA_MATMUL_TRANSPOSED_SHARED
+    return (index % TILE_K) * (WORKGROUP_SIZE_M * TILE_M + 2u) + index / TILE_K;
+#else
+    return (index / TILE_K) * (TILE_K + 2u) + index % TILE_K;
+#endif
+}
+fn novera_src1_index(index: u32) -> u32 {
+#ifdef NOVERA_MATMUL_TRANSPOSED_SHARED
+    let i = index - TILE_SRC0_SHMEM;
+    return TILE_K * (WORKGROUP_SIZE_M * TILE_M + 2u) + (i % TILE_K) * (WORKGROUP_SIZE_N * TILE_N + 2u) + i / TILE_K;
+#else
+    return (index / TILE_K) * (TILE_K + 2u) + index % TILE_K;
+#endif
 }
