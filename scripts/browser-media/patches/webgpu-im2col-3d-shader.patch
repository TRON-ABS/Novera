--- /dev/null
+++ b/src/ggml-webgpu/wgsl-shaders/im2col_3d.wgsl
@@ -0,0 +1,35 @@
+enable f16;
+@group(0) @binding(0) var<storage, read_write> input: array<INPUT_TYPE>;
+@group(0) @binding(1) var<storage, read_write> output: array<OUTPUT_TYPE>;
+struct Params {
+ offset_i:u32,offset_o:u32,
+ si0:u32,si1:u32,si2:u32,si3:u32,
+ KW:u32,KH:u32,KD:u32,IC:u32,
+ IW:u32,IH:u32,ID:u32,N:u32,
+ OW:u32,OH:u32,OD:u32,
+ s0:u32,s1:u32,s2:u32,p0:u32,p1:u32,p2:u32,d0:u32,d1:u32,d2:u32,
+}
+@group(0) @binding(2) var<uniform> params:Params;
+@compute @workgroup_size(WG_SIZE)
+fn main(@builtin(global_invocation_id) gid:vec3<u32>,@builtin(num_workgroups) groups:vec3<u32>) {
+ let index=gid.x + groups.x*u32(WG_SIZE)*gid.y;
+ let K=params.KW*params.KH*params.KD*params.IC;
+ let M=params.OW*params.OH*params.OD;
+ if(index>=K*M*params.N){return;}
+ var k=index%K;var m=index/K;
+ let kw=k%params.KW;k=k/params.KW;
+ let kh=k%params.KH;k=k/params.KH;
+ let kd=k%params.KD;let ic=k/params.KD;
+ let ow=m%params.OW;m=m/params.OW;
+ let oh=m%params.OH;m=m/params.OH;
+ let od=m%params.OD;let n=m/params.OD;
+ let iw=i32(ow*params.s0+kw*params.d0)-i32(params.p0);
+ let ih=i32(oh*params.s1+kh*params.d1)-i32(params.p1);
+ let depth=i32(od*params.s2+kd*params.d2)-i32(params.p2);
+ var value=INPUT_TYPE(0.0);
+ if(iw>=0 && iw<i32(params.IW) && ih>=0 && ih<i32(params.IH) && depth>=0 && depth<i32(params.ID)){
+  let at=params.offset_i+u32(iw)*params.si0+u32(ih)*params.si1+u32(depth)*params.si2+(n*params.IC+ic)*params.si3;
+  value=input[at];
+ }
+ output[params.offset_o+index]=OUTPUT_TYPE(value);
+}
