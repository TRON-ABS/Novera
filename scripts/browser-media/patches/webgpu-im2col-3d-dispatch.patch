+static webgpu_encoded_op ggml_webgpu_im2col_3d(webgpu_context & ctx, ggml_tensor * src0, ggml_tensor * src1, ggml_tensor * dst) {
+    const uint32_t ic = ggml_get_op_params_i32(dst, 9);
+    const uint32_t n = src1->ne[3] / ic;
+    std::vector<uint32_t> params = {
+        (uint32_t)(ggml_webgpu_tensor_misalignment(ctx, src1) / ggml_type_size(src1->type)),
+        (uint32_t)(ggml_webgpu_tensor_misalignment(ctx, dst) / ggml_type_size(dst->type)),
+        (uint32_t)(src1->nb[0] / ggml_type_size(src1->type)),
+        (uint32_t)(src1->nb[1] / ggml_type_size(src1->type)),
+        (uint32_t)(src1->nb[2] / ggml_type_size(src1->type)),
+        (uint32_t)(src1->nb[3] / ggml_type_size(src1->type)),
+        (uint32_t)src0->ne[0], (uint32_t)src0->ne[1], (uint32_t)src0->ne[2], ic,
+        (uint32_t)src1->ne[0], (uint32_t)src1->ne[1], (uint32_t)src1->ne[2], n,
+        (uint32_t)dst->ne[1], (uint32_t)dst->ne[2], (uint32_t)dst->ne[3]/n,
+    };
+    for (int i=0;i<9;++i) params.push_back((uint32_t)ggml_get_op_params_i32(dst,i));
+    std::vector<wgpu::BindGroupEntry> entries = {
+        ggml_webgpu_make_tensor_bind_group_entry(ctx, 0, src1),
+        ggml_webgpu_make_tensor_bind_group_entry(ctx, 1, dst),
+    };
+    ggml_webgpu_shader_lib_context shader_lib_ctx = {};
+    shader_lib_ctx.src0=src0;shader_lib_ctx.src1=src1;shader_lib_ctx.dst=dst;
+    shader_lib_ctx.max_wg_size=ctx->global_ctx->capabilities.limits.maxComputeInvocationsPerWorkgroup;
+    webgpu_pipeline pipeline=ctx->shader_lib->get_im2col_pipeline(shader_lib_ctx);
+    auto * decisions=static_cast<ggml_webgpu_generic_shader_decisions *>(pipeline.context.get());
+    uint32_t wg_x,wg_y;
+    compute_2d_workgroups(CEIL_DIV((uint32_t)ggml_nelements(dst),decisions->wg_size),ctx->global_ctx->capabilities.limits.maxComputeWorkgroupsPerDimension,wg_x,wg_y);
+    return ggml_backend_webgpu_build(ctx,pipeline,params,entries,wg_x,wg_y);
+}
