--- a/src/core/ggml_extend.cpp
+++ b/src/core/ggml_extend.cpp
@@ -884,8 +884,15 @@
 
     x = ggml_group_norm(ctx, x, num_groups, eps);
     if (w != nullptr && b != nullptr) {
+#if defined(__EMSCRIPTEN__)
+        // GROUP_NORM may run on the CPU while affine operations use WebGPU.
+        // An in-place view would retain the CPU result buffer for a GPU write.
+        x = ggml_mul(ctx, x, w);
+        x = ggml_add(ctx, x, b);
+#else
         x = ggml_mul_inplace(ctx, x, w);
         x = ggml_add_inplace(ctx, x, b);
+#endif
     }
     return x;
 }
