@@ -555,7 +555,12 @@
     }
     if (b != nullptr) {
         b = ggml_reshape_4d(ctx, b, 1, 1, 1, b->ne[0]);  // [OC, 1, 1, 1]
+#if defined(__EMSCRIPTEN__)
+        // Unsupported CONV_3D can fall back to CPU before this GPU affine op.
+        x = ggml_add(ctx, x, b);
