+// A contiguous group is a row over spatial dimensions and its channels.
+// Reuse the stable two-pass F32 normalization shader without CPU readback.
+static webgpu_encoded_op ggml_webgpu_group_norm(webgpu_context & ctx, ggml_tensor * src, ggml_tensor * dst) {
+    const int groups = ggml_get_op_params_i32(dst, 0);
+    GGML_ASSERT(groups > 0 && src->ne[2] % groups == 0);
+    GGML_ASSERT(ggml_is_contiguous(src) && ggml_is_contiguous(dst));
+    ggml_tensor input = *src;
+    ggml_tensor output = *dst;
+    const int64_t width = src->ne[0] * src->ne[1] * (src->ne[2] / groups);
+    for (ggml_tensor * row : {&input, &output}) {
+        row->ne[0] = width; row->ne[1] = groups; row->ne[2] = src->ne[3]; row->ne[3] = 1;
+        row->nb[0] = sizeof(float);
+        for (int i = 1; i < GGML_MAX_DIMS; ++i) row->nb[i] = row->nb[i - 1] * row->ne[i - 1];
+    }
+    output.op = GGML_OP_NORM;
+    const float epsilon = ggml_get_op_params_f32(dst, 1);
+    memcpy(output.op_params, &epsilon, sizeof(epsilon));
+    return ggml_webgpu_row_norm(ctx, &input, &output);
 }
 
