 // All the base objects needed to run operations on a WebGPU device
+// Retain handles so a destroyed/replaced tensor cannot alias a cached binding.
+struct webgpu_cached_bind_group {
+    wgpu::ComputePipeline pipeline;
+    std::vector<wgpu::BindGroupEntry> entries;
+    wgpu::BindGroup group;
+
+    bool matches(const wgpu::ComputePipeline & candidate, const std::vector<wgpu::BindGroupEntry> & bindings) const {
+        if (pipeline.Get() != candidate.Get() || entries.size() != bindings.size()) return false;
+        for (size_t i = 0; i < entries.size(); ++i) {
+            const auto & a = entries[i];
+            const auto & b = bindings[i];
+            if (a.nextInChain || b.nextInChain || a.binding != b.binding || a.buffer.Get() != b.buffer.Get() ||
+                a.offset != b.offset || a.size != b.size || a.sampler.Get() != b.sampler.Get() ||
+                a.textureView.Get() != b.textureView.Get()) return false;
+        }
+        return true;
+    }
+};
