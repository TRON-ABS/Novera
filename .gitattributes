Cargo.lock -diff

# Lockfiles are generated; collapse them in review and keep them out of language stats.
# `linguist-generated` rather than `-diff` so `git diff` still works for security audits.
*yarn.lock linguist-generated=true

# Component lock hashes must be identical on Windows and Unix checkouts.
src-tauri/components/*.txt text eol=lf linguist-generated=true
src-tauri/components/*.in text eol=lf
src-tauri/components/*.json text eol=lf

# A signature authenticates exact bytes, including line endings.
src-tauri/src/core/cli/signed-update-fixtures/* -text
src-tauri/src/core/cli/signed-update-fixtures/*.bin binary

# Provenance hashes cover exact patch bytes; unified-diff context blanks carry
# their required leading space and must not be rewritten as ordinary prose.
docs/release-evidence/**/APPLICATION-SOURCE.patch -text -whitespace
